pipeline {
    agent any

    environment {
        APP_NAME    = 'devops-lab1-app'
        APP_VERSION = '1.0.0'
        NODE_ENV    = 'production'
        DOCKER_IMAGE = "devops-lab1-app:${BUILD_NUMBER}"
        PORT        = '3000'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 1: Checkout
        // Pull the latest source code from the GitHub repository
        // ─────────────────────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                echo '========== STAGE 1: Checkout =========='
                checkout scm
                sh 'echo "Branch: $(git rev-parse --abbrev-ref HEAD)"'
                sh 'echo "Commit: $(git rev-parse --short HEAD)"'
                sh 'echo "Author: $(git log -1 --pretty=%an)"'
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 2: Install Dependencies
        // Install all Node.js packages using npm ci (clean install)
        // ─────────────────────────────────────────────────────────────────────
        stage('Install Dependencies') {
            steps {
                echo '========== STAGE 2: Install Dependencies =========='
                dir('app') {
                    sh 'node --version'
                    sh 'npm --version'
                    sh 'npm ci'
                    sh 'echo "Dependencies installed successfully"'
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 3: Lint
        // Run ESLint to check code quality and style compliance
        // ─────────────────────────────────────────────────────────────────────
        stage('Lint') {
            steps {
                echo '========== STAGE 3: Lint =========='
                dir('app') {
                    sh 'npm run lint'
                    echo 'Lint check passed — no code quality issues found'
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 4: Test
        // Run Jest unit tests and generate coverage report
        // ─────────────────────────────────────────────────────────────────────
        stage('Test') {
            steps {
                echo '========== STAGE 4: Test =========='
                dir('app') {
                    sh 'npm test -- --ci --reporters=default --reporters=jest-junit || true'
                }
            }
            post {
                always {
                    dir('app') {
                        // Archive coverage report if it exists
                        sh 'ls coverage/ 2>/dev/null && echo "Coverage report generated" || echo "No coverage dir"'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 5: Build
        // Package the application (create a production-ready artifact)
        // ─────────────────────────────────────────────────────────────────────
        stage('Build') {
            steps {
                echo '========== STAGE 5: Build =========='
                sh 'mkdir -p build'
                sh 'cp -r app/ build/app/'
                sh 'cd build/app && npm ci --omit=dev'
                sh '''
                    echo "Build Metadata" > build/BUILD_INFO.txt
                    echo "App:       ${APP_NAME}"         >> build/BUILD_INFO.txt
                    echo "Version:   ${APP_VERSION}"      >> build/BUILD_INFO.txt
                    echo "Build #:   ${BUILD_NUMBER}"     >> build/BUILD_INFO.txt
                    echo "Branch:    $(git rev-parse --abbrev-ref HEAD)" >> build/BUILD_INFO.txt
                    echo "Commit:    $(git rev-parse --short HEAD)"      >> build/BUILD_INFO.txt
                    echo "Built At:  $(date -u +\\'%Y-%m-%dT%H:%M:%SZ\\')" >> build/BUILD_INFO.txt
                '''
                sh 'cat build/BUILD_INFO.txt'
                archiveArtifacts artifacts: 'build/BUILD_INFO.txt', fingerprint: true
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 6: Docker Build
        // Build a Docker image for the application
        // ─────────────────────────────────────────────────────────────────────
        stage('Docker Build') {
            steps {
                echo '========== STAGE 6: Docker Build =========='
                sh 'docker --version'
                sh "docker build -t ${DOCKER_IMAGE} -t ${APP_NAME}:latest ."
                sh "docker image inspect ${DOCKER_IMAGE} --format 'Image Size: {{.Size}} bytes'"
                echo "Docker image '${DOCKER_IMAGE}' built successfully"
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // STAGE 7: Deploy
        // Stop any running instance and deploy the new container
        // ─────────────────────────────────────────────────────────────────────
        stage('Deploy') {
            steps {
                echo '========== STAGE 7: Deploy =========='
                // Stop and remove any existing container
                sh "docker stop ${APP_NAME} 2>/dev/null || true"
                sh "docker rm   ${APP_NAME} 2>/dev/null || true"
                // Start the new container
                sh """
                    docker run -d \\
                        --name ${APP_NAME} \\
                        --restart unless-stopped \\
                        -p ${PORT}:${PORT} \\
                        -e NODE_ENV=${NODE_ENV} \\
                        ${DOCKER_IMAGE}
                """
                // Wait for the app to start, then health-check it
                sh 'sleep 5'
                sh "curl -sf http://localhost:${PORT}/health && echo 'Health check PASSED' || echo 'Health check FAILED'"
                echo "App deployed and running at http://localhost:${PORT}"
            }
        }

    }

    post {
        success {
            echo """
            ============================================
             BUILD SUCCESSFUL
             App:     ${APP_NAME} v${APP_VERSION}
             Build:   #${BUILD_NUMBER}
             Status:  All 7 stages passed
            ============================================
            """
        }
        failure {
            echo """
            ============================================
             BUILD FAILED
             App:     ${APP_NAME} v${APP_VERSION}
             Build:   #${BUILD_NUMBER}
             Action:  Check the console output above
            ============================================
            """
        }
        always {
            echo 'Pipeline execution complete.'
            // Clean up the build directory after each run
            sh 'rm -rf build/ 2>/dev/null || true'
        }
    }
}
